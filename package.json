{
  "name": "my-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Vue 3 UI component library",
  "keywords": [
    "vue",
    "ui",
    "components",
    "library"
  ],
  "license": "MIT",
  "main": "./dist/my-ui.cjs.js",
  "module": "./dist/my-ui.es.js",
  "exports": {
    ".": {
      "import": "./dist/my-ui.es.js",
      "require": "./dist/my-ui.cjs.js"
    },
    "./dist/my-ui.css": "./dist/my-ui.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "cross-env BUILD_MODE=lib vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write --experimental-cli src/",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "pinia": "^3.0.4",
    "vue": "^3.5.30",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.2",
    "@vue/test-utils": "^2.4.6",
    "cross-env": "^7.0.3",
    "eslint": "^10.1.0",
    "eslint-plugin-vue": "^10.8.0",
    "jsdom": "^29.0.1",
    "prettier": "3.8.1",
    "sass": "^1.98.0",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.7",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
